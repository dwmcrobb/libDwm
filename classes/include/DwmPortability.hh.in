//---------------------------------------------------------------------------
//!  \file DwmPortability.hh
//!  \brief A configure target for dealing with OS differences.
//---------------------------------------------------------------------------

#undef HAVE_BYTESWAP_H
#undef HAVE_ENDIAN_H
#undef HAVE_SYS_ENDIAN_H

#ifdef HAVE_SYS_ENDIAN_H
  extern "C" {
    #include <sys/endian.h>
  }
#endif

#if HAVE_ENDIAN_H
  extern "C" {
    #include <endian.h>
  }
#endif

#if HAVE_BYTESWAP_H
  extern "C" {
    #include <byteswap.h>
  }
#endif

//  Linux has bswap_16()/bswap_32()/bswap_64() instead of
//  bswap16()/bswap32()/bswap64()
#ifndef bswap16
  #ifdef bswap_16
    #define bswap16(x)  bswap_16((x))
  #endif
#endif
#ifndef bswap32
  #ifdef bswap_32
    #define bswap32(x)  bswap_32((x))
  #endif
#endif
#ifndef bswap64
  #ifdef bswap_64
    #define bswap64(x)  bswap_64((x))
  #endif
#endif

// little-endian to/from big-endian
#ifndef le16tobe
  #define le16tobe(x) bswap16((x))
#endif
#ifndef le32tobe
  #define le32tobe(x) bswap32((x))
#endif
#ifndef le64tobe
  #define le64tobe(x) bswap64((x))
#endif
#ifndef be16tole
  #define be16tole(x) bswap16((x))
#endif
#ifndef be32tole
  #define be32tole(x) bswap32((x))
#endif
#ifndef be64tole
  #define be64tole(x) bswap64((x))
#endif

#undef HAVE_CPP0X
#undef HAVE_TR1
#undef HAVE_CPP11
#undef HAVE_CPP1Z
#undef HAVE_CPP17
#undef HAVE_CPP20
#undef HAVE_CPP23

#define HAVE_GPLUSPLUS_VERSION(MAJOR, MINOR) \
  (__GNUC__ > (MAJOR) || (__GNUC__ == (MAJOR) && __GNUC_MINOR__ >= (MINOR)))

#undef HAVE_NET_PFVAR_H
#undef HAVE_NET_IF_PFLOG_H
// #undef DWM_HAVE_STD_FORMAT
#undef DWM_HAVE_LIBFMT

